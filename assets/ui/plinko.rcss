/* RmlUi Stylesheet for 3D Plinko Native Cross-Platform Builds */

body {
  font-family: monospace;
  font-size: 13px;
  color: #e2e8f0;
  margin: 0;
  padding: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.plinko-panel {
  position: absolute;
  top: 14px;
  left: 14px;
  width: 320px;
  background-color: #0a140fef;
  border: 1.5px #10b98173;
  border-radius: 10px;
  padding: 12px 14px;
  display: block;
}

.plinko-panel.mobile-minimized {
  display: none;
}

.plinko-header {
  border-bottom: 1.5px #10b9814d;
  padding-bottom: 8px;
  margin-bottom: 10px;
}

.plinko-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.plinko-title {
  font-size: 15px;
  font-weight: bold;
  color: #10b981;
}

.plinko-subtitle {
  font-size: 9px;
  color: #a7f3d0cc;
  margin-top: 2px;
}

.plinko-btn-close {
  width: 22px;
  height: 22px;
  background-color: transparent;
  border: 1px #10b9814d;
  color: #94a3b8;
  border-radius: 4px;
  text-align: center;
}

.plinko-stat-box {
  background-color: #0f172aa6;
  border: 1px #ffffff14;
  border-radius: 8px;
  padding: 8px;
  display: flex;
  margin-bottom: 10px;
}

.plinko-stat-cell {
  width: 50%;
  text-align: center;
  padding: 4px;
}

.plinko-stat-label {
  font-size: 8.5px;
  color: #6ee7b7;
  display: block;
}

.plinko-stat-value {
  font-size: 14px;
  font-weight: bold;
  color: #ffffff;
  display: block;
}

.plinko-control-group {
  border-bottom: 1px #ffffff14;
  padding-bottom: 8px;
  margin-bottom: 8px;
}

.plinko-group-label {
  font-size: 9.5px;
  color: #94a3b8;
  margin-bottom: 5px;
  display: block;
}

.plinko-grid-selector {
  display: flex;
  justify-content: space-between;
}

.plinko-btn-tab {
  width: 31%;
  padding: 5px;
  font-size: 10.5px;
  border-radius: 5px;
  background-color: #0f172a99;
  border: 1px #10b98133;
  color: #94a3b8;
  text-align: center;
}

.plinko-btn-tab.active {
  background-color: #10b98133;
  border-color: #10b981;
  color: #34d399;
}

.plinko-action-group {
  margin-top: 8px;
}

.plinko-btn-primary {
  width: 100%;
  background-color: #10b981;
  color: #ffffff;
  padding: 8px;
  font-size: 12px;
  font-weight: bold;
  border-radius: 7px;
  border: none;
  margin-bottom: 6px;
  text-align: center;
}

.plinko-btn-secondary {
  width: 100%;
  background-color: #0f172a99;
  border: 1px #ffffff1a;
  color: #94a3b8;
  padding: 6px;
  font-size: 10px;
  border-radius: 5px;
  text-align: center;
}

.plinko-mobile-fab {
  position: absolute;
  bottom: 18px;
  left: 14px;
  background-color: #0a140fea;
  border: 1.5px #10b981;
  border-radius: 20px;
  padding: 8px 16px;
  color: #34d399;
  font-size: 11px;
}

/* RmlUi Mobile 100% Full-Screen Fitting Rules */
@media (max-width: 768px) {
  .plinko-panel {
    top: 0;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 100%;
    max-height: 100%;
    border-radius: 0;
    border: none;
    padding: 16px 14px;
    box-sizing: border-box;
  }
}
